# ---------------------------------------------------------------------------
# NEXORA AI AUTOPILOT — environment template
# Copy to .env and fill in. NEVER commit a real .env file.
# Any value left blank makes the corresponding feature report
# NOT_CONFIGURED in the UI instead of producing fabricated data.
# ---------------------------------------------------------------------------

# --- Core -----------------------------------------------------------------
APP_ENV=development
APP_SECRET=
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(64))"
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# --- Datastores -----------------------------------------------------------
DATABASE_URL=postgresql+psycopg://nexora:nexora@localhost:5432/nexora
TEST_DATABASE_URL=postgresql+psycopg://nexora:nexora@localhost:5432/nexora_test
REDIS_URL=redis://localhost:6379/0

# --- Encryption -----------------------------------------------------------
# 32-byte urlsafe-base64 key used to encrypt OAuth tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Object storage (S3-compatible: MinIO, Cloudflare R2, AWS S3) ---------
STORAGE_BACKEND=local
# local | s3
STORAGE_LOCAL_PATH=./data/storage
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# --- LLM provider (topic ideas, research synthesis, scripts, fact check) ---
LLM_PROVIDER=
# anthropic | openai  (blank = NOT_CONFIGURED)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# --- Voice provider -------------------------------------------------------
VOICE_PROVIDER=
# openai | elevenlabs  (blank = NOT_CONFIGURED)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- YouTube (OAuth 2.0 Web application credentials) ----------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/youtube/oauth/callback
# Server API key used for public Data API reads (trending videos, search).
YOUTUBE_API_KEY=

# --- Trend sources --------------------------------------------------------
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=nexora-autopilot/0.1 (by /u/your-reddit-username)

# --- Media ----------------------------------------------------------------
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
RENDER_WORK_DIR=./data/render

# --- Worker ---------------------------------------------------------------
WORKER_CONCURRENCY=1
JOB_MAX_RETRIES=3
